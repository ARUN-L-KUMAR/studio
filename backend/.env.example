# Copy this file to ".env" and fill in what you use. Never commit ".env".
# Most of these can also be saved from the app's Settings page.

# --- Server (only needed when deploying) ---
# APP_HOST=0.0.0.0              # listen for other devices (default 127.0.0.1 = this computer only)
# APP_PORT=8000
# APP_RELOAD=0                  # 0 on a server
# APP_OPEN_BROWSER=0            # 0 on a server
# APP_PASSWORD=                 # optional; "python set_password.py" is better (stores a hash)
# APP_ALLOWED_ORIGINS=https://studio.example.com

# --- Hugging Face tokens (the app tries them in order and skips ones out of GPU quota) ---
HF_TOKEN=
HF_TOKEN_2=
HF_TOKEN_3=

# --- Caption AI (use any; the app falls back from one to the next) ---
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# --- Instagram, official API (recommended; accounts can also be added in Settings) ---
CLOUDINARY_URL=                 # cloudinary://API_KEY:API_SECRET@CLOUD_NAME
IG_USER_ID=
IG_ACCESS_TOKEN=

# --- Instagram, browser/phone login (needed only for songs on posts) ---
IG_USERNAME=
IG_PASSWORD=
IG_SESSION_ID=
